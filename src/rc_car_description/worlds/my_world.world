<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="my_world">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Required Gazebo Harmonic plugins -->
    <plugin filename="gz-sim8-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim8-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim8-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim8-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim8-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim8-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="my_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0.4 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- ========================================================
         GROUND PLANE
         NOTE: the lidar_link on the car sits ~0.29m above the ground
         (see rc_car.urdf.xacro), so any obstacle shorter than about
         0.20m sits entirely below the 2D lidar's scan plane and will
         NOT show up in /scan. Obstacles below are tagged with either
         "LIDAR-BLIND" (too short to see) or "THIN" (narrow enough
         that its angular width can fall between adjacent lidar beams
         at longer range) so you know which ones need the camera/depth
         sensor or careful low-speed driving to avoid.
    ======================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.45 1</ambient>
            <diffuse>0.6 0.6 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         OUTER WALLS - 20x20 meter arena
    ======================================================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         SERPENTINE MAZE WALLS
         Five 4m-wide corridors (x: -10..-6, -6..-2, -2..2, 2..6, 6..10)
         connected by alternating gaps at the top/bottom, forcing an
         S-shaped route from the start (bottom-left) to the goal
         (bottom-right corridor). Each wall is a different color.
    ======================================================== -->
    <model name="maze_wall_a">
      <static>true</static>
      <pose>-6 -3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 13 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 13 1.5</size></box></geometry>
          <material><ambient>0.15 0.35 0.9 1</ambient><diffuse>0.15 0.35 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="maze_wall_b">
      <static>true</static>
      <pose>-2 3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 13 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 13 1.5</size></box></geometry>
          <material><ambient>0.95 0.55 0.1 1</ambient><diffuse>0.95 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="maze_wall_c">
      <static>true</static>
      <pose>2 -3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 13 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 13 1.5</size></box></geometry>
          <material><ambient>0.15 0.75 0.25 1</ambient><diffuse>0.15 0.75 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="maze_wall_d">
      <static>true</static>
      <pose>6 3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 13 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 13 1.5</size></box></geometry>
          <material><ambient>0.55 0.2 0.75 1</ambient><diffuse>0.55 0.2 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         CORRIDOR 1  (x: -10 .. -6)  -- start corridor
    ======================================================== -->
    <model name="crate_1_red">
      <static>true</static>
      <pose>-8.5 -6 0.35 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_1_thin">
      <!-- THIN: 4cm-diameter pole, easy to lose between lidar beams at range -->
      <static>true</static>
      <pose>-7.2 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="curb_1_lowprofile">
      <!-- LIDAR-BLIND: 0.15m tall, sits below the ~0.29m scan plane -->
      <static>true</static>
      <pose>-8.7 4.5 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.4 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.4 0.15</size></box></geometry>
          <material><ambient>0.9 0.2 0.6 1</ambient><diffuse>0.9 0.2 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         CORRIDOR 2  (x: -6 .. -2)
    ======================================================== -->
    <model name="curb_2_lowprofile">
      <!-- LIDAR-BLIND: spans most of the corridor width -->
      <static>true</static>
      <pose>-4 7 0.09 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 2.2 0.18</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 2.2 0.18</size></box></geometry>
          <material><ambient>0.1 0.7 0.7 1</ambient><diffuse>0.1 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="sphere_2_orange">
      <static>true</static>
      <pose>-3.2 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>0.95 0.55 0.1 1</ambient><diffuse>0.95 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_2_thin">
      <!-- THIN pole -->
      <static>true</static>
      <pose>-4.6 -8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.15 0.75 0.25 1</ambient><diffuse>0.15 0.75 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         CORRIDOR 3  (x: -2 .. 2)  -- thin-pole slalom
    ======================================================== -->
    <model name="pole_3a">
      <static>true</static>
      <pose>-0.9 -7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.03</radius><length>1</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.03</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.9 1</ambient><diffuse>0.15 0.35 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_3b">
      <static>true</static>
      <pose>0.9 -4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.03</radius><length>1</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.03</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.6 1</ambient><diffuse>0.9 0.2 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_3c">
      <static>true</static>
      <pose>-0.9 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.03</radius><length>1</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.03</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_3_tall">
      <static>true</static>
      <pose>0 6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.55 0.2 0.75 1</ambient><diffuse>0.55 0.2 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         CORRIDOR 4  (x: 2 .. 6)
    ======================================================== -->
    <model name="curb_4_lowprofile">
      <!-- LIDAR-BLIND ramp across the corridor -->
      <static>true</static>
      <pose>4 -0.5 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 0.6 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 0.6 0.2</size></box></geometry>
          <material><ambient>0.1 0.7 0.7 1</ambient><diffuse>0.1 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_4_yellow_big">
      <static>true</static>
      <pose>3 6.5 0.6 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 1.2 1.2</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_4_thin">
      <!-- THIN pole -->
      <static>true</static>
      <pose>5 -6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================
         CORRIDOR 5  (x: 6 .. 10)  -- goal corridor
    ======================================================== -->
    <model name="sphere_5_small">
      <static>true</static>
      <pose>8.5 -5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><ambient>0.15 0.35 0.9 1</ambient><diffuse>0.15 0.35 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="curb_5_lowprofile">
      <!-- LIDAR-BLIND -->
      <static>true</static>
      <pose>7 0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.4 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 0.4 0.15</size></box></geometry>
          <material><ambient>0.15 0.75 0.25 1</ambient><diffuse>0.15 0.75 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_5_final">
      <static>true</static>
      <pose>8.7 5.5 0.4 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.95 0.55 0.1 1</ambient><diffuse>0.95 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
