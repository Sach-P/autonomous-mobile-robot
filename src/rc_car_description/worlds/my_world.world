<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="my_world">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim8-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim8-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim8-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim8-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim8-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim8-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.62 0.73 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0.3 0.2 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.2 -0.9</direction>
    </light>

    <!-- These seven floor sections leave open holes at both pit locations. -->
    <model name="wood_floor_south"><static>true</static><pose>0 -7.45 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20 5.1 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 5.1 0.1</size></box></geometry><material><ambient>0.38 0.19 0.07 1</ambient><diffuse>0.52 0.29 0.11 1</diffuse><specular>0.08 0.04 0.01 1</specular></material></visual></link></model>
    <model name="wood_floor_east_pit_left"><static>true</static><pose>-3.4 -3.5 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>13.2 2.8 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>13.2 2.8 0.1</size></box></geometry><material><ambient>0.55 0.29 0.10 1</ambient><diffuse>0.68 0.39 0.15 1</diffuse></material></visual></link></model>
    <model name="wood_floor_east_pit_right"><static>true</static><pose>7.9 -3.5 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4.2 2.8 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.2 2.8 0.1</size></box></geometry><material><ambient>0.35 0.17 0.06 1</ambient><diffuse>0.47 0.25 0.09 1</diffuse></material></visual></link></model>
    <model name="wood_floor_middle"><static>true</static><pose>0 -0.85 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20 2.5 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 2.5 0.1</size></box></geometry><material><ambient>0.55 0.29 0.10 1</ambient><diffuse>0.68 0.39 0.15 1</diffuse></material></visual></link></model>
    <model name="wood_floor_west_pit_left"><static>true</static><pose>-7.15 2 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>5.7 3.2 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>5.7 3.2 0.1</size></box></geometry><material><ambient>0.35 0.17 0.06 1</ambient><diffuse>0.47 0.25 0.09 1</diffuse></material></visual></link></model>
    <model name="wood_floor_west_pit_right"><static>true</static><pose>4.15 2 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>11.7 3.2 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>11.7 3.2 0.1</size></box></geometry><material><ambient>0.55 0.29 0.10 1</ambient><diffuse>0.68 0.39 0.15 1</diffuse></material></visual></link></model>
    <model name="wood_floor_north"><static>true</static><pose>0 6.8 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20 6.4 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 6.4 0.1</size></box></geometry><material><ambient>0.35 0.17 0.06 1</ambient><diffuse>0.47 0.25 0.09 1</diffuse></material></visual></link></model>

    <!-- Arena boundaries. -->
    <model name="wall_north"><static>true</static><pose>0 10 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.2 2</size></box></geometry><material><diffuse>0.72 0.72 0.70 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -10 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.2 2</size></box></geometry><material><diffuse>0.72 0.72 0.70 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>10 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 20 2</size></box></geometry><material><diffuse>0.72 0.72 0.70 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-10 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 20 2</size></box></geometry><material><diffuse>0.72 0.72 0.70 1</diffuse></material></visual></link></model>

    <!-- True 1.2m-deep floor openings: no lip, no collision surface at ground level. -->
    <model name="pit_west"><static>true</static><pose>-3 2 0 0 0 0</pose><link name="link">
      <collision name="bottom"><pose>0 0 -1.2 0 0 0</pose><geometry><box><size>2.6 3.2 0.1</size></box></geometry></collision>
      <visual name="bottom_visual"><pose>0 0 -1.2 0 0 0</pose><geometry><box><size>2.6 3.2 0.1</size></box></geometry><material><diffuse>0.015 0.02 0.025 1</diffuse></material></visual>
    </link></model>
    <model name="pit_east"><static>true</static><pose>4.5 -3.5 0 0 0 0</pose><link name="link">
      <collision name="bottom"><pose>0 0 -1.2 0 0 0</pose><geometry><box><size>2.6 2.8 0.1</size></box></geometry></collision>
      <visual name="bottom_visual"><pose>0 0 -1.2 0 0 0</pose><geometry><box><size>2.6 2.8 0.1</size></box></geometry><material><diffuse>0.015 0.02 0.025 1</diffuse></material></visual>
    </link></model>

    <!-- Large, high-contrast objects provide dependable YOLO targets at varied distances and viewpoints. -->
    <model name="red_crate"><static>true</static><pose>-6 -5.5 0.45 0 0 0.25</pose><link name="link"><collision name="collision"><geometry><box><size>0.9 0.9 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.9 0.9 0.9</size></box></geometry><material><ambient>0.75 0.04 0.03 1</ambient><diffuse>0.9 0.06 0.04 1</diffuse></material></visual></link></model>
    <model name="blue_barrel"><static>true</static><pose>0 -6 0.55 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.38</radius><length>1.1</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.38</radius><length>1.1</length></cylinder></geometry><material><ambient>0.03 0.20 0.72 1</ambient><diffuse>0.04 0.30 0.95 1</diffuse></material></visual></link></model>
    <model name="green_crate"><static>true</static><pose>6.8 4.7 0.6 0 0 -0.35</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 1.2 1.2</size></box></geometry><material><ambient>0.03 0.55 0.12 1</ambient><diffuse>0.05 0.76 0.17 1</diffuse></material></visual></link></model>
    <model name="orange_cone"><static>true</static><pose>2.2 5.8 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cone><radius>0.32</radius><length>1.0</length></cone></geometry></collision><visual name="visual"><geometry><cone><radius>0.32</radius><length>1.0</length></cone></geometry><material><ambient>0.95 0.28 0.01 1</ambient><diffuse>1 0.38 0.02 1</diffuse></material></visual></link></model>
    <model name="purple_sphere"><static>true</static><pose>-6.5 6.2 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><sphere><radius>0.45</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.45</radius></sphere></geometry><material><ambient>0.45 0.06 0.70 1</ambient><diffuse>0.58 0.08 0.9 1</diffuse></material></visual></link></model>
    <model name="yellow_column"><static>true</static><pose>7.2 -6.2 0.9 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.68 0.02 1</ambient><diffuse>1 0.82 0.03 1</diffuse></material></visual></link></model>

  </world>
</sdf>
